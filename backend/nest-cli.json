{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    },
    "clientes": {
      "type": "application",
      "root": "apps/clientes",
      "entryFile": "main",
      "sourceRoot": "apps/clientes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/clientes/tsconfig.app.json"
      }
    },
    "ventas": {
      "type": "application",
      "root": "apps/ventas",
      "entryFile": "main",
      "sourceRoot": "apps/ventas/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ventas/tsconfig.app.json"
      }
    },
    "stock": {
      "type": "application",
      "root": "apps/stock",
      "entryFile": "main",
      "sourceRoot": "apps/stock/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stock/tsconfig.app.json"
      }
    },
    "caja": {
      "type": "application",
      "root": "apps/caja",
      "entryFile": "main",
      "sourceRoot": "apps/caja/src",
      "compilerOptions": {
        "tsConfigPath": "apps/caja/tsconfig.app.json"
      }
    },
    "facturacion": {
      "type": "application",
      "root": "apps/facturacion",
      "entryFile": "main",
      "sourceRoot": "apps/facturacion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/facturacion/tsconfig.app.json"
      }
    }
  }
}