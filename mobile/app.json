{
  "expo": {
    "name": "Pintame",
    "slug": "pintame-mobile",
    "scheme": "pintame",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pintame-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/pintame-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Pintame usa la cámara para escanear códigos de productos.",
          "microphonePermission": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pintame usa tu ubicación solo si elegís adjuntarla a una venta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
